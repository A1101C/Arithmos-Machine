---
// src/components/blockmath.astro
import katex from 'katex';

interface Props {
  formula: string;
}

const { formula } = Astro.props;

//displayMode is true for centered block text
const html = katex.renderToString(formula, { displayMode: true });
---
<div class="math-block" set:html={html} />

<style>
  .math-block {
    margin: 1.5rem 0;
    overflow-x: auto;
  }
</style>