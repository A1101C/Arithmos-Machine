---
// src/components/lessontemplate.astro
import Layout from '../layouts/layout.astro';

interface Resource {
  name: string;
  url: string;
}

interface Props {
  metaTitle: string;
  resources?: Resource[];
}

const { metaTitle, resources = [] } = Astro.props;
---

<Layout title={`${metaTitle} | Explicanda`}>
  <article class="lesson-container">
    
    <slot /> {resources.length > 0 && (
      <footer class="lesson-resources">
        <h3>Additional Resources</h3>
        <ul class="resource-list">
          {resources.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                <span>{item.name}</span>
                <span class="arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</Layout>

<style>
  .lesson-container {
    width: 92vw;
    max-width: 1400px; 
    margin: 2rem auto;
    padding: 2.5rem;
    box-sizing: border-box;
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .lesson-resources {
    margin-top: 5rem;
    border-top: 1px solid #e2e8f0;
    padding-top: 2rem;
  }

  .lesson-resources h3 {
    font-size: 1.1rem;
    color: #2d3748;
    margin-bottom: 1rem;
  }

  .resource-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .resource-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: #4a5568;
    font-weight: 600;
    transition: all 0.2s ease-in-out;
  }

  .resource-list a:hover {
    transform: translateX(4px);
    border-color: #007bff;
    color: #007bff;
    box-shadow: 0 4px 10px -3px rgba(0, 123, 255, 0.1);
  }

  .arrow { transition: transform 0.2s ease-in-out; }
  .resource-list a:hover .arrow { transform: translateX(4px); }

  @media (max-width: 600px) {
    .lesson-container {
      width: 100vw;
      padding: 1.5rem;
      margin: 1rem auto;
      border-radius: 0;
    }
  }
</style>