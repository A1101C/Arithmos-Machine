---
// src/components/graphwindow.astro
---

<div class="graph-shell" id="graphShell">
    <canvas id="graphCanvas"></canvas>
    <div class="graph-empty" id="graphEmpty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
        <p>Graph will appear here after evaluation</p>
    </div>
</div>

<style>
    .graph-shell {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 400px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
        box-sizing: border-box;
    }

    #graphCanvas {
        display: none;
        width: 100%;
        height: 100%;
        cursor: grab;
    }

    #graphCanvas:active {
        cursor: grabbing;
    }

    .graph-empty {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: #adb5bd;
    }

    .graph-empty p {
        font-size: 0.9rem;
        margin: 0;
    }
</style>

<script>
    function initGraph() {
        const canvas = document.getElementById('graphCanvas') as HTMLCanvasElement;
        const empty = document.getElementById('graphEmpty');

        if (!canvas || canvas.dataset.initialized) return;
        canvas.dataset.initialized = 'true';

        let lastPoints: {x: number, y: number}[] = [];
        let cx = 0; //center X in coordinates
        let cy = 0; //center Y in coordinates
        let ppu = 0; //pixels per unit (controls zoom & handles 1:1 scaling)
        let isDragging = false;
        let lastMouse = { x: 0, y: 0 };
        const pad = { top: 40, right: 40, bottom: 56, left: 68 };

        //updated view domain to fetch newly visible data segments
        function triggerFetchBounds() {
            const plotW = canvas.width - pad.left - pad.right;
            if (plotW <= 0 || ppu === 0) return;
            const xMin = cx - (plotW / 2) / ppu;
            const xMax = cx + (plotW / 2) / ppu;
            window.dispatchEvent(new CustomEvent('graph:request_fetch', { detail: { xMin, xMax } }));
        }

        //interaction handlers
        canvas.addEventListener('mousedown', (e) => {
            isDragging = true;
            lastMouse = { x: e.clientX, y: e.clientY };
        });

        window.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                triggerFetchBounds();
            }
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const dx = e.clientX - lastMouse.x;
            const dy = e.clientY - lastMouse.y;
            lastMouse = { x: e.clientX, y: e.clientY };

            cx -= dx / ppu;
            cy += dy / ppu; // canvas y goes down, math y goes up

            draw(lastPoints);
        });

        canvas.addEventListener('wheel', (e) => {
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            const mouseX = e.clientX - rect.left;
            const mouseY = e.clientY - rect.top;

            const plotW = canvas.width - pad.left - pad.right;
            const plotH = canvas.height - pad.top - pad.bottom;

            //prevent zooming if mouse is in padding margins
            if (mouseX < pad.left || mouseX > canvas.width - pad.right) return;
            if (mouseY < pad.top || mouseY > canvas.height - pad.bottom) return;

            //map coordinates under cursor *before* zooming
            const mathX = cx + (mouseX - (pad.left + plotW / 2)) / ppu;
            const mathY = cy - (mouseY - (pad.top + plotH / 2)) / ppu;

            //apply zoom factor smoothly
            const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1;
            ppu *= zoomFactor;
            
            //boundary constraints
            if (ppu < 1e-4) ppu = 1e-4;
            if (ppu > 1e6) ppu = 1e6;

            //move camera so cursor stays glued to original coordinate
            cx = mathX - (mouseX - (pad.left + plotW / 2)) / ppu;
            cy = mathY + (mouseY - (pad.top + plotH / 2)) / ppu;

            draw(lastPoints);
            triggerFetchBounds();
        });

        function drawIfHasData() {
            if (lastPoints.length > 0) draw(lastPoints);
        }

        window.addEventListener('panel:toggled', () => setTimeout(() => drawIfHasData(), 320));

        function draw(parsed: {x: number, y: number}[]) {
            const shell = document.getElementById('graphShell');
            if (!shell) return;

            canvas.style.display = 'block';
            if (empty) empty.style.display = 'none';

            canvas.width = shell.clientWidth;
            canvas.height = shell.clientHeight;

            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            const W = canvas.width;
            const H = canvas.height;
            const plotW = W - pad.left - pad.right;
            const plotH = H - pad.top - pad.bottom;

            //first draw: initialize 1:1 constraints and -10 to 10 x domain
            if (ppu === 0 && plotW > 0) {
                ppu = plotW / 20; //exact x range size of 20 (from -10 to 10)
                cx = 0;
                cy = 0; // base Y axis in the physical center automatically scales via ppu 
            }

            const xMin = cx - (plotW / 2) / ppu;
            const xMax = cx + (plotW / 2) / ppu;
            const yMin = cy - (plotH / 2) / ppu;
            const yMax = cy + (plotH / 2) / ppu;

            const toX = (x: number) => pad.left + (x - xMin) * ppu;
            const toY = (y: number) => pad.top + plotH - (y - yMin) * ppu;

            ctx.clearRect(0, 0, W, H);

            //grid calculation 
            const xRange = plotW / ppu;
            const roughStep = xRange / 6;
            const stepMag = Math.pow(10, Math.floor(Math.log10(roughStep)));
            let step = stepMag;
            if (roughStep / stepMag >= 5) step *= 5;
            else if (roughStep / stepMag >= 2) step *= 2;

            ctx.strokeStyle = '#f0f0f0';
            ctx.lineWidth = 1;

            const firstX = Math.floor(xMin / step) * step;
            for (let x = firstX; x <= xMax; x += step) {
                const gx = toX(x);
                ctx.beginPath(); ctx.moveTo(gx, pad.top); ctx.lineTo(gx, pad.top + plotH); ctx.stroke();
            }

            const firstY = Math.floor(yMin / step) * step;
            for (let y = firstY; y <= yMax; y += step) {
                const gy = toY(y);
                ctx.beginPath(); ctx.moveTo(pad.left, gy); ctx.lineTo(pad.left + plotW, gy); ctx.stroke();
            }

            // axes
            const axisY = Math.max(pad.top, Math.min(pad.top + plotH, toY(0)));
            const axisX = Math.max(pad.left, Math.min(pad.left + plotW, toX(0)));
            
            ctx.strokeStyle = '#ced4da';
            ctx.lineWidth = 1.5;
            ctx.beginPath(); ctx.moveTo(pad.left, axisY); ctx.lineTo(pad.left + plotW, axisY); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(axisX, pad.top); ctx.lineTo(axisX, pad.top + plotH); ctx.stroke();

            // axis labels 
            ctx.fillStyle = '#868e96';
            ctx.font = '12px system-ui, sans-serif';
            ctx.textBaseline = 'middle';

            for (let x = firstX; x <= xMax; x += step) {
                if (Math.abs(x) < 1e-10) continue; 
                ctx.textAlign = 'center';
                ctx.fillText(parseFloat(x.toPrecision(4)).toString(), toX(x), Math.min(pad.top + plotH + 14, axisY + 14));
            }

            for (let y = firstY; y <= yMax; y += step) {
                if (Math.abs(y) < 1e-10) continue;
                ctx.textAlign = 'right';
                ctx.fillText(parseFloat(y.toPrecision(4)).toString(), Math.max(pad.left - 6, axisX - 6), toY(y));
            }
            
            ctx.textAlign = 'right';
            ctx.fillText('0', axisX - 6, axisY + 14);

            ctx.fillStyle = '#495057';
            ctx.font = '13px system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('x', pad.left + plotW / 2, H - 10);
            ctx.save();
            ctx.translate(14, pad.top + plotH / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText('y', 0, 0);
            ctx.restore();

            //curve and fill
            if (parsed.length > 0) {
                ctx.save();
                ctx.beginPath();
                ctx.rect(pad.left, pad.top, plotW, plotH);
                ctx.clip(); // ensure zoomed rendering doesn't paint outside container
                
                ctx.beginPath();
                parsed.forEach((p, i) => {
                    i === 0 ? ctx.moveTo(toX(p.x), toY(p.y)) : ctx.lineTo(toX(p.x), toY(p.y));
                });
                ctx.lineTo(toX(parsed[parsed.length - 1].x), axisY);
                ctx.lineTo(toX(parsed[0].x), axisY);
                ctx.closePath();
                ctx.fillStyle = 'rgba(0, 123, 255, 0.07)';
                ctx.fill();

                ctx.beginPath();
                ctx.strokeStyle = '#007bff';
                ctx.lineWidth = 2.5;
                ctx.lineJoin = 'round';
                ctx.lineCap = 'round';
                parsed.forEach((p, i) => {
                    i === 0 ? ctx.moveTo(toX(p.x), toY(p.y)) : ctx.lineTo(toX(p.x), toY(p.y));
                });
                ctx.stroke();

                ctx.restore();
            }
        }

        window.addEventListener('graph:update', (e: Event) => {
            const { points } = (e as CustomEvent).detail;
            if (!points || points.length === 0) return;

            lastPoints = points
                .map((p: {x: string, y: string}) => ({ x: parseFloat(p.x), y: parseFloat(p.y) }))
                .filter((p: {x: number, y: number}) => !isNaN(p.x) && !isNaN(p.y));

            draw(lastPoints);
        });
    }

    initGraph();
    document.addEventListener('astro:page-load', initGraph);
</script>