---
// src/components/tutorialcomponents/subtopic.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="subtopic-section">
  <h2>{title}</h2>
  <div class="subtopic-content">
    <slot />
  </div>
</section>

<style>
  .subtopic-section {
    margin-top: 3.5rem;
    margin-bottom: 2rem;
  }

  .subtopic-section h2 {
    font-size: 1.75rem;
    font-weight: 500;
    color: #2d3748;
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .subtopic-content :global(p) {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #2d3748;
    margin-bottom: 1.5rem;
  }
  
  .subtopic-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .subtopic-content :global(h3) {
    font-size: 1.25rem; 
    font-weight: 500;
    color: #2d3748;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .subtopic-content :global(h4) {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.7;
    color: #2d3748;
    margin-bottom: 1.5rem;

  }
</style>