---
// src/pages/index.astro
import Layout from '../../layouts/layout.astro';

const scientificBg = '/sci.png';
const graphingBg = '/graph.png';
---

<Layout title="Home | Explicanda">
    
    <div class="button-grid">
        
        <div class="menu-item">
            <a href="/tutorials/numbers" class="tutorial-btn" style={`--bg-img: url(${scientificBg})`}>
            </a>
            <span class="btn-label">Numbers</span>
        </div>

    </div>

</Layout>

<style>
    .button-grid {
        display: flex;
        gap: 3rem;
        padding: 2rem;
        max-width: 800px;
        width: 100%;
        box-sizing: border-box;
    }

    .menu-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .tutorial-btn {
        width: 100%;
        height: 200px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease-in-out;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        
        background-image: var(--bg-img);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #ffffff;
    }

    .btn-label {
        margin-top: 1rem;
        font-size: 1.2rem;
        font-weight: 600;
        color: #4a5568;
        transition: color 0.2s ease-in-out;
    }

    .menu-item:hover .calc-btn {
        transform: translateY(-4px);
        border-color: #007bff;
        box-shadow: 0 10px 15px -3px rgba(0, 123, 255, 0.1);
    }

    .menu-item:hover .btn-label {
        color: #007bff;
    }

    .calc-btn:active {
        transform: translateY(-1px);
    }

    @media (max-width: 600px) {
        .button-grid {
            flex-direction: column;
            gap: 2rem;
        }
    }
</style>