import SubTopic from '../../components/lessoncomponents/subtopic.astro';
import Linemath from '../../components/lessoncomponents/linemath.astro';
import BlockMath from '../../components/lessoncomponents/blockmath.astro';

const mathLinks = [
  { name: "Georg Cantor's First Set Theory Article", url: "https://encyclopedia.pub/entry/32557" },

  {
    name: "On a Property of the Class of all Real Algebraic Numbers. by Georg Cantor", 
    url: "/documents/cantor1874.pdf"
  },

  { name: "World Record Pi Calculation", url: "https://www.guinnessworldrecords.com/world-records/66179-most-accurate-value-of-pi" },

  { name: "How Many Decimals of Pi Do We Really Need?", url: "https://www.jpl.nasa.gov/edu/news/how-many-decimals-of-pi-do-we-really-need/" },
